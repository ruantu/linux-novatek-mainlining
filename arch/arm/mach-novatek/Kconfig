menuconfig ARCH_NOVATEK
	bool "Novatek SoC support"
	depends on ARCH_MULTI_V7
	help
	  Support for Novatek ARMv7 SoCs.

if ARCH_NOVATEK

config MACH_NA51089
	bool "Novatek NA51089 SoC support"
	default ARCH_NOVATEK
	select ARM_GIC
	select ARM_GLOBAL_TIMER
	select CACHE_L2X0
	select PINCTRL
	select PINCTRL_NOVATEK_NA51089
	select PM
	select PM_GENERIC_DOMAINS
	help
	  Support for Novatek NT9856x (NA51089) SoCs.

endif
